# Copy this file to .env and fill in real values for your machine.
# Nothing in this file is a real credential - these are placeholders only.

PRODUCT_UPLOAD_RESULTS_DIR=C:\Users\you\Downloads\
PRODUCT_REFERENCE_TABLE_DIR=C:\data\InvoicePlatform\06.ScheduledAutomation\01.RawData_ReferenceTable\
PRODUCT_ERROR_FILES_DIR=C:\data\InvoicePlatform\06.ScheduledAutomation\03.ErrorMessageFiles\

# Comma-separated list of folders that receive per-store/supplier upload files
PRODUCT_UPLOAD_FILES_DIRS=C:\data\InvoicePlatform\06.ScheduledAutomation\02.UploadFiles\,C:\Users\you\Desktop\InvoicePlatformAutomation\03.UploadFiles\

# Comma-separated list of folders that get purged of files older than 30-60 days
PRODUCT_CLEANUP_DIRS=C:\Users\you\Desktop\InvoicePlatformAutomation\03.UploadFiles\,C:\data\InvoicePlatform\06.ScheduledAutomation\98.ResultsFiles\,C:\data\InvoicePlatform\06.ScheduledAutomation\02.UploadFiles\
PRODUCT_VENDOR_LIST_DIR=C:\data\InvoicePlatform\0.VendorsList\
